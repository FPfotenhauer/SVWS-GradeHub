SVWSSERVER_PORT=8443
SVWSSERVER_HOST=localhost
SVWSSERVER_SCHEMA=svwsdb
SVWSSERVER_USER=Admin
# SVWSSERVER_PASSWORD darf hier NICHT gesetzt werden – Passwörter werden durch Vite in den JS-Bundle gebacken und sind dann im Browser sichtbar.

# Auf false setzen, um den Bereich "Vom SVWS-Server laden" auszublenden (Lehrkraft-Modus)
ADMINTOOL_VISIBLE=false
